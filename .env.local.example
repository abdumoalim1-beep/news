# كلمة سر لوحة التحكم (/admin) — غيّرها إلى كلمة سر قوية وخاصة بك
ADMIN_PASSWORD=change-me

# مطلوبة فقط عند النشر على استضافة serverless مثل فيرسل (غير مطلوبة محليًا).
# عند ضبطها، يرفع الحفظ من لوحة التحكم commit مباشرًا إلى المستودع بدل الكتابة
# على القرص. راجع قسم "النشر على فيرسل" في README.md لطريقة إنشاء GITHUB_TOKEN.
# GITHUB_TOKEN=
# GITHUB_REPO=abdumoalim1-beep/news
# GITHUB_BRANCH=main

# رابط الموقع الفعلي — يُستخدم لبناء وسوم Open Graph/Twitter (صورة ورابط
# المعاينة عند مشاركة رابط في X/واتساب وغيرها). القيمة الافتراضية بدون ضبطه
# هي https://forma.sale
# NEXT_PUBLIC_SITE_URL=https://forma.sale
